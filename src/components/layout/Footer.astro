---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>© {year} Andrés Castrillón. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 32px 0;
    background: linear-gradient(to bottom, transparent, rgba(22, 27, 34, 0.4));
    border-top: 1px solid rgba(48, 54, 61, 0.5);
    color: var(--muted);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    margin-top: 24px;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 18px;
    font-size: 13px;
    opacity: 0.6;
    display: flex;
    justify-content: center;
    letter-spacing: 0.01em;
  }

  p {
    margin: 0;
  }
</style>
