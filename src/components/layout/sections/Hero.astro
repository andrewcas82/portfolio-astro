---
import profile from "../../../data/profile";
import AnimatedGradient from "../../ui/animated-gradient";

const name = profile.fullName;
const headline = profile.headline;
const summary = profile.summary;

const primaryCta = { label: "View Projects", href: "/projects/" };
const secondaryCta = { label: "Contact", href: "/contact/" };

const proof = [
  { label: "XR", value: "Unity / OpenXR / XRI" },
  { label: "Mobile", value: "Flutter (Android/iOS)" },
  { label: "Domain", value: "Aviation maintenance & QC" },
];
---

<section class="hero-wrapper" aria-label="Hero">
  <div class="hero-bg-glow" aria-hidden="true">
    <AnimatedGradient client:load config={{ preset: "Plasma", speed: 15 }} />
    <div class="hero-bg-mask"></div>
  </div>

  <div class="hero-content">
    <div class="intro">
    <p class="kicker">Portfolio</p>
    <h1 class="title">{name}</h1>
    <p class="headline">{headline}</p>
    <p class="summary">{summary}</p>

    <div class="cta" role="group" aria-label="Primary actions">
      <a class="btn primary" href={primaryCta.href}>{primaryCta.label}</a>
      <a class="btn" href={secondaryCta.href}>{secondaryCta.label}</a>
    </div>
  </div>

  <aside class="proof" aria-label="Proof points">
    <h2 class="proofTitle">Focus</h2>
    <dl class="proofGrid">
      {proof.map((p) => (
        <div class="proofItem">
          <dt>{p.label}</dt>
          <dd>{p.value}</dd>
        </div>
      ))}
    </dl>
  </aside>
  </div>

  <style>
    .hero-wrapper {
      position: relative;
      margin: -34px -18px 0; /* Negate the BaseLayout padding to bleed full width */
      padding: 34px 18px 0;
    }

    .hero-bg-glow {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 600px;
      z-index: 0;
      opacity: 0.15;
      overflow: hidden;
      pointer-events: none;
    }

    .hero-bg-mask {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 0%, var(--bg) 100%);
      z-index: 1;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      display: grid;
      gap: 18px;
      grid-template-columns: 1.25fr 0.75fr;
      align-items: start;
      max-width: 1100px;
      margin: 0 auto;
    }

    @media (max-width: 900px) {
      .hero-content { grid-template-columns: 1fr; }
    }

    .kicker {
      margin: 0;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.7;
    }

    .title {
      margin: 6px 0 0;
      font-size: 40px;
      letter-spacing: -0.03em;
      line-height: 1.05;
    }

    .headline {
      margin: 10px 0 0;
      font-size: 16px;
      opacity: 0.9;
      max-width: 80ch;
    }

    .summary {
      margin: 10px 0 0;
      opacity: 0.85;
      max-width: 90ch;
    }

    .cta {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 14px;
    }

    .btn {
      text-decoration: none;
      padding: 10px 14px;
      border-radius: 14px;
      border: 1px solid var(--border);
      color: var(--text);
      opacity: 0.92;
      transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
      background-color: var(--surface);
    }

    .btn:hover {
      opacity: 1;
      transform: translateY(-2px);
      border-color: rgba(88,166,255,0.4);
    }

    .btn:focus-visible {
      outline: 2px solid rgba(88,166,255,0.65);
      outline-offset: 2px;
      border-color: rgba(88,166,255,0.5);
    }

    .primary {
      background-color: rgba(88,166,255,0.1);
      border-color: rgba(88,166,255,0.25);
      color: var(--link);
      font-weight: 600;
    }

    .primary:hover {
      background-color: rgba(88,166,255,0.15);
      border-color: rgba(88,166,255,0.5);
    }

    .proof {
      border: 1px solid var(--border);
      background-color: var(--surface);
      border-radius: 16px;
      padding: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    }

    .proofTitle {
      margin: 0 0 10px;
      font-size: 14px;
      opacity: 0.8;
    }

    .proofGrid {
      margin: 0;
      display: grid;
      gap: 10px;
    }

    .proofItem dt {
      font-size: 12px;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .proofItem dd {
      margin: 2px 0 0;
      font-size: 14px;
      opacity: 0.9;
    }
  </style>
</section>
